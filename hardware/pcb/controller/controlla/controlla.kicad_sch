	(title_block
		(title "SQ-CTRL controller - top level")
		(date "2026-11-16")
		(rev "A")
		(company "Squashimoto")
		(comment 1 "Sheets: Power, MCU, Drives, IO")
	)
	(lib_symbols)
	(text "Power tree (SPEC.md section 2)\nXT30 30-42 V -> F1 7 A -> Q1 reverse protection -> VBAT\n  VBAT -> U1 buck -> +5V (Pi feed J2, lidar switch, LDO, LEDs, buzzer)\n  +5V or USB VBUS -> Schottky OR -> U2 LDO -> +3V3\n  VBAT -> over-voltage cut-off -> VM_ACT -> actuator driver (Drives)\n  VBAT -> 100k/5.1k divider -> VBAT_SENSE -> ESP32 ADC (MCU)\nRails cross sheets as power symbols; signals cross as sheet pins."
		(exclude_from_sim no)
