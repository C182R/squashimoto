	)
	(text "U14 lifts the LED data from 3.3 V to 5 V, the LED's own supply (SPEC.md 2).\nR46 (10R) limits the buzzer current, D13 catches its coil when Q8 turns off.\nR48 holds BUZZER (IO14) low at reset: one chirp at boot, then silence (SPEC.md 3).\n"
		(exclude_from_sim no)
		(at 20.32 279.146 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "26f689c5-9353-4748-a927-0e1148c4f6a4")
	)
	(text "Status LED (5 V level shift) and buzzer"
		(exclude_from_sim no)
		(at 20.32 203.95 0)
		(effects
