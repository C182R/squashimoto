			(justify left top)
		)
		(uuid "74efd5eb-a4cb-40bd-829e-56330db75974")
	)
	(text "Closed: 5.1 V / 1.66k = 3.1 mA, ESTOP_DIV = 3.07 V (high = run)\nOpen, broken or grounded wire: 0 V (low = stop)\nR31 10k / C29 100n filter. GPIO35 can also read it as ADC1_CH7, hypothetically."
		(exclude_from_sim no)
		(at 264.16 102.87 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a10c4783-f5c5-4c05-96b7-d1f2a92252e9")
	)
