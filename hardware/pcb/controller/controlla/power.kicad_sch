	(text "Pi feed: 5 V / 3 A"
		(exclude_from_sim no)
		(at 22.7795 177.8573 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "00111bca-c8d5-4d53-a11e-10269f29a11b")
	)
	(text "D4/D5: the board's +5V and USB VBUS can each feed the LDO; neither can feed the other (D-10).\nVBUS arrives from the USB-C connector on the MCU sheet.\nD6/R10: power-on LED, 1-1.5 mA."
		(exclude_from_sim no)
		(at 153.416 227.076 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "29ad8755-cc50-4137-b030-20c1ebfc4776")
	)
	(text "Q1: D1 holds the gate 12 V below the source, R1 pulls it low: fully on from 27 V up.\nReverse battery: the body diode blocks and the gate stays at source potential.\nD2 sits after Q1 so a reversed pack is not shorted through it.\nVBAT_SENSE = VBAT x 5.1/105.1  (42 V -> 2.04 V, 30 V -> 1.46 V), to the MCU sheet"
		(exclude_from_sim no)
		(at 23.114 84.582 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2c827b5c-8c21-4db3-b736-35fa9b8f5131")
	)
	(text "3.3 V LDO, fed from +5V or USB VBUS (Schottky OR, D-10)"
		(exclude_from_sim no)
		(at 153.6542 177.9917 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "43519a38-4b8c-4e97-ad16-cbd3e0a1c467")
	)
	(text "scope ground loops"
		(exclude_from_sim no)
		(at 216.916 65.532 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6545a277-3285-44c9-a945-d3c7b278145a")
	)
	(text "UVLO: start 26.8 V, stop 24.3 V (R4/R5)\nfsw = 92417 x 240^-0.991 = 405 kHz (R6)\nVout = 0.8 x (1 + 53.6/10) = 5.09 V (R7/R8)\nL1 XAL1010-103: 60 V rated, Isat 17.5 A > 6.8 A max current limit; ripple 1.1 A p-p\nComp R9/C10/C11: fc 3.6 kHz, PM > 65 deg in all cases\nD3 100 V: sees clamped surge + ringing"
		(exclude_from_sim no)
		(at 22.352 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "65f95a74-3ec9-492d-99ec-78a539f97878")
	)
	(text "Battery input: fuse, reverse-polarity FET, TVS, bulk  (HV class, 42 V)"
		(exclude_from_sim no)
		(at 22.86 23.61 0)
		(effects
			(font
